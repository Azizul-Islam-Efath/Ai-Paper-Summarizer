# Backend Environment Variables — COPY THIS TO .env AND FILL IN VALUES

PORT=5000
NODE_ENV=production

# ─── Database (MySQL cloud provider e.g. Aiven, TiDB Cloud, Railway) ────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED"

# ─── JWT Secrets (use strong random strings in production) ────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Frontend URL (for CORS — comma-separated if multiple) ────────────────────
FRONTEND_URL=https://your-app.vercel.app,http://localhost:5173

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# ─── Email (Gmail App Password for password reset) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com

# ─── Redis (optional — for job queue) ────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
